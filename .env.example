APP_NAME="Avdhara"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
FRONTEND_URL=http://localhost:3000

# ── Sending real email ────────────────────────────────────────────────────────
# MAIL_MAILER=log writes messages to storage/logs and sends nothing. That is the right default for
# development and the wrong one anywhere a person is expecting an email, so it has to be changed
# deliberately. `php artisan mail:test you@example.com` proves the settings before a campaign does.
#
# Any SMTP provider works. Ports: 587 with MAIL_SCHEME=smtp (STARTTLS) is the usual choice; 465
# needs MAIL_SCHEME=smtps.
#
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
#
# The from address must be on a domain whose SPF and DKIM records name this provider. Without both,
# bulk mail lands in spam however well written it is — and Gmail rejects it outright at volume.
# MAIL_FROM_ADDRESS="hello@gurukul2.com"

# The shared secret the provider sends back with bounce and complaint webhooks, at
# POST /webhooks/email in the header X-Webhook-Secret. Unset means that endpoint answers 404 to
# everybody. Without it, bounced addresses are never marked and the list rots silently.
EMAIL_WEBHOOK_SECRET=
